# Copier en .env pour surcharger les valeurs par défaut (le .env n'est jamais commité).
# Aucune de ces variables n'est obligatoire : docker-compose.yml fournit des défauts.

# --- Modèle -------------------------------------------------------------------
# Modèle HuggingFace zero-shot (NLI multilingue)
MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
# Prompt zero-shot : "simple" (retenu : accuracy 0.656) ou "fr" (libellés descriptifs : 0.614)
PROMPT_MODE=simple
# 1 = quantification dynamique int8. NE PAS ACTIVER avec mDeBERTa : -34 % de latence
# mais accuracy 0.154 (hasard). Conservé pour documenter l'expérience.
QUANTIZE=0
# Threads torch par process (0 = auto)
TORCH_THREADS=2
# Timeout d'une inférence en secondes (au-delà : HTTP 504)
INFERENCE_TIMEOUT=10
# Tentatives de chargement du modèle avant arrêt du conteneur (relancé par Docker)
MODEL_LOAD_RETRIES=3

# Inférences simultanées par réplica. Règle : MAX_CONCURRENT_INFERENCES x TORCH_THREADS = nb de cœurs.
# Mesuré sur 4 cœurs : 2 x 2 = 2,43 inf/s, contre 1,78 inf/s en 1 x 4.
MAX_CONCURRENT_INFERENCES=2
# Requêtes en attente max avant rejet immédiat en 503 + Retry-After (load shedding)
MAX_QUEUE=4

# --- Cache Redis --------------------------------------------------------------
CACHE_TTL=3600

# --- Ports publiés sur l'hôte -------------------------------------------------
NGINX_PORT=80
API_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOCUST_PORT=8089

# --- Grafana (CHANGER en dehors de la démo) -----------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Divers -------------------------------------------------------------------
LOG_LEVEL=INFO
# Image API (la CI pousse ghcr.io/dluffy07/inferloop:<sha>)
API_IMAGE=inferloop-api:local
